    }
  },
  "typography": {
    "heading": {"family": "Manrope, Inter, ui-sans-serif, system-ui", "weights": [600, 700, 800]},
    "body": {"family": "Inter, Manrope, ui-sans-serif, system-ui", "weights": [400, 500, 600, 700]},
    "scale": {"xs": "12px", "sm": "13px", "base": "15px", "lg": "17px", "xl": "20px", "2xl": "26px", "3xl": "34px", "4xl": "42px"},
    "lineHeight": {"tight": 1.15, "normal": 1.5, "relaxed": 1.65}
  },
  "layout": {
    "sidebarWidth": "242px",
    "topbarHeight": "76px",
    "contentPadding": "24px 28px 36px",
    "gridGap": "16px",
    "desktopReference": "1536x1024",
    "tabletBreakpoint": "1080px",
    "mobileBreakpoint": "760px"
  },
  "spacing": {"1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"},
  "radius": {"sm": "8px", "md": "10px", "lg": "14px", "card": "16px", "panel": "20px", "pill": "999px"},
  "shadow": {
    "card": "0 5px 20px rgba(55, 65, 50, 0.045)",
    "floating": "0 12px 32px rgba(22, 53, 44, 0.14)",
    "dropdown": "0 14px 36px rgba(25, 49, 40, 0.15)"
  },
  "components": {
    "button": {"height": "42px", "radius": "10px", "fontSize": "14px"},
    "card": {"background": "surface.card", "border": "surface.border", "radius": "16px", "shadow": "shadow.card"},
    "input": {"height": "42px", "radius": "10px", "border": "surface.borderStrong", "focusRing": "rgba(8, 120, 94, 0.22)"},
    "sidebarItem": {"height": "48px", "radius": "10px", "iconSize": "20px"},
    "dropdown": {"radius": "14px", "shadow": "shadow.dropdown", "itemHeight": "42px"},
    "statusPill": {"radius": "999px", "fontSize": "12px", "fontWeight": 600}
  },
  "accessibility": {
    "minInteractiveTargetTouch": "44px",
    "focusVisible": "3px solid rgba(8, 120, 94, 0.32)",
    "statusMustIncludeText": true,
    "imagesRequireAltText": true,
    "dropdownsMustSupportKeyboard": true,
    "motionRespectReducedMotion": true
  }
