REDIS_URL=redis://localhost:6379/0
BROWSER_SESSION_PREFIX=civicflow:browser:
SESSION_TTL_SECONDS=1800
# Keep mock mode for local UI development. Set to playwright after installing Chromium.
CIVICFLOW_BROWSER_RUNTIME=mock
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CIVICFLOW_ALLOW_LOCAL_MOCK=true
