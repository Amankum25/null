APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://civicflow:replace-with-local-db-password@localhost:5432/civicflow
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-storage-secret
OBJECT_STORAGE_BUCKET=civicflow-documents
JWT_SECRET_KEY=replace-with-a-long-random-secret
AI_AGENT_URL=http://localhost:8001
BROWSER_AGENT_URL=http://localhost:8002
USE_MOCK_AI=true
USE_MOCK_BROWSER=true
CORS_ORIGINS=["http://localhost:3000"]
