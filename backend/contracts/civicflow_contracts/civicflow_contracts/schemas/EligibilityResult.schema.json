{
  "$defs": {
    "EligibilityOutcome": {
      "enum": [
        "eligible",
        "ineligible",
        "needs_information",
        "unknown"
      ],
      "title": "EligibilityOutcome",
      "type": "string"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "SourceCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "eligible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eligible"
    },
    "outcome": {
      "$ref": "#/$defs/EligibilityOutcome"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "source_citations": {
      "items": {
        "$ref": "#/$defs/SourceCitation"
      },
      "title": "Source Citations",
      "type": "array"
    }
  },
  "required": [
    "outcome"
  ],
  "title": "EligibilityResult",
  "type": "object"
}
