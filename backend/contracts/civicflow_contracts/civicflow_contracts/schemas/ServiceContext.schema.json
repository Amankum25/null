{
  "$defs": {
    "ServiceSummary": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "title": "Service Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "jurisdiction": {
          "default": "",
          "title": "Jurisdiction",
          "type": "string"
        },
        "portal_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portal Url"
        },
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Domains",
          "type": "array"
        }
      },
      "required": [
        "service_id",
        "name",
        "category"
      ],
      "title": "ServiceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "service": {
      "$ref": "#/$defs/ServiceSummary"
    },
    "eligibility_rules": {
      "additionalProperties": true,
      "title": "Eligibility Rules",
      "type": "object"
    },
    "required_documents": {
      "items": {
        "type": "string"
      },
      "title": "Required Documents",
      "type": "array"
    },
    "source_urls": {
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Urls",
      "type": "array"
    }
  },
  "required": [
    "service"
  ],
  "title": "ServiceContext",
  "type": "object"
}
